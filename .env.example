MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=geek_system
MYSQL_USER=geek
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_BYTES
INTERNAL_SERVICE_KEY=CHANGE_ME_INTERNAL_SERVICE_KEY
PAYMENT_CALLBACK_SECRET=CHANGE_ME_PAYMENT_CALLBACK_SECRET
RABBITMQ_USER=geek
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=geek-product-documents
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
NACOS_USER=CHANGE_ME_NACOS_USER
NACOS_PASSWORD=CHANGE_ME_NACOS_PASSWORD
NACOS_AUTH_TOKEN=CHANGE_ME_NACOS_AUTH_TOKEN
NACOS_AUTH_ENABLE=false
NACOS_AUTH_IDENTITY_KEY=CHANGE_ME_NACOS_IDENTITY_KEY
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME_NACOS_IDENTITY_VALUE
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# Set true outside a single-developer workstation. Compose then refuses to
# start while any documented placeholder or insecure Nacos setting remains.
GEEK_SHARED_ENVIRONMENT=false

# Stage5 · LLM (OpenAI-compatible). Put real key only in .env (gitignored).
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
EMBEDDING_URL=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_API_KEY=
KNOWLEDGE_INDEX=geek-knowledge-v2
AI_MODEL_PRIMARY=deepseek-v4-flash
AI_MODEL_FALLBACK=geek-chat-fallback

# Real payment switches (default SIMULATED)
PAYMENT_WECHAT_ENABLED=false
PAYMENT_ALIPAY_ENABLED=false

# Gateway / merchant → AI (compose network). Host hot-reload:
# AI_SERVICE_URI=http://host.docker.internal:9011
AI_SERVICE_URI=http://ai:9011
AI_SERVICE_URL=http://ai:9011
