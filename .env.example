MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=geek_system
MYSQL_USER=geek
MYSQL_PASSWORD=geek_local_password
JWT_SECRET=change-this-local-secret-at-least-32-bytes-long
INTERNAL_SERVICE_KEY=change-internal-service-key
PAYMENT_CALLBACK_SECRET=change-payment-callback-secret
RABBITMQ_USER=geek
RABBITMQ_PASSWORD=geek_local_password
MINIO_ACCESS_KEY=geek
MINIO_SECRET_KEY=geek_local_password
MINIO_BUCKET=geek-product-documents
NACOS_USER=nacos
NACOS_PASSWORD=nacos
NACOS_AUTH_TOKEN=VGhpc0lzQVNlY3VyZUxvY2FsVG9rZW5Gb3JHZWVrTWFsbE5hY29z

# Stage5 · LLM (OpenAI-compatible). Put real key only in .env (gitignored).
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
AI_MODEL_PRIMARY=deepseek-v4-flash
AI_MODEL_FALLBACK=geek-chat-fallback
MILVUS_ENABLED=false

# Real payment switches (default SIMULATED)
PAYMENT_WECHAT_ENABLED=false
PAYMENT_ALIPAY_ENABLED=false

# Gateway / merchant → AI (compose network). Host hot-reload:
# AI_SERVICE_URI=http://host.docker.internal:9011
AI_SERVICE_URI=http://ai:9011
AI_SERVICE_URL=http://ai:9011
