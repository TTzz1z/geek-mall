{
  "name": "geek-mall-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev:mall": "pnpm --filter @geek-mall/mall-web dev",
    "dev:admin": "pnpm --filter @geek-mall/admin-web dev",
    "dev:mobile": "pnpm --filter @geek-mall/mobile-uniapp dev",
    "dev:ops": "pnpm --filter @geek-mall/ops-screen dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test --run"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "jsdom": "25.0.1",
    "sass": "1.81.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5",
    "vue-tsc": "2.1.10"
  }
}
